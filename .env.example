OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_STT_MODEL=scribe_v2_realtime
ELEVEN_TTS_MODEL=eleven_flash_v2_5
# Natural turn-taking: silence before a transcript commits, then a cancellable reply delay.
ELEVEN_VAD_SILENCE_SECONDS=1.3
TURN_END_DELAY_SECONDS=0.7
INCOMPLETE_TURN_DELAY_SECONDS=1.8
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
INSURER_PHONE_NUMBER=
DOCTOR_PHONE_NUMBER=
# Incoming webhook for the dedicated ATP Slack channel. Keep this URL secret.
SLACK_WEBHOOK_URL=
# Optional stable HTTPS app URL. Otherwise make demo supplies its tunnel URL.
PUBLIC_BASE_URL=
# Hosted approval reader. Blank disables automatic completion updates.
DOCUPDATES_BASE_URL=https://docupdates.vercel.app
# Legacy insurer variable, still supported:
DEMO_PAYER_PHONE_NUMBER=
APP_DEMO_PASSWORD=
APP_PORT=8000
DATABASE_PATH=./.local/atp.sqlite3
DEMO_MAX_CALL_SECONDS=600
# Optional: explicitly select an existing LiveKit outbound trunk.
LIVEKIT_SIP_TRUNK_ID=
